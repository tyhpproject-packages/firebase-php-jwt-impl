{
    "name": "tyhpdef/firebase-php-jwt-impl",
    "description": "Implementation package for tyhpdef/firebase-php-jwt. Require tyhpdef/firebase-php-jwt, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "7.1.1.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/firebase-php-jwt"
        }
    },
    "require": {
        "php": ">=8.2",
        "firebase/php-jwt": "^7.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev"
    }
}
